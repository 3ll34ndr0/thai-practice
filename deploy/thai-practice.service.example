[Unit]
Description=Thai speaking practice app
After=network.target

[Service]
Type=simple
User=thai-practice
WorkingDirectory=/opt/thai-practice/backend
EnvironmentFile=/opt/thai-practice/.env
ExecStart=/opt/thai-practice/.venv/bin/uvicorn main:app \
	--host 0.0.0.0 --port 8123 \
	--proxy-headers --forwarded-allow-ips=10.42.0.0/16
Restart=on-failure

# Basic hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
